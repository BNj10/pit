# Local values are shown by npm run supabase:status after starting the stack.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
# Copy the Publishable key from the status output.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Copy the Secret key from the status output. Server-only: never prefix it with NEXT_PUBLIC_.
# Needed to resolve student ID logins.
SUPABASE_SECRET_KEY=
